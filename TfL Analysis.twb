      <column caption='Peak vs non peak hours' datatype='string' name='[Calculation_1627699437474455552]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;hour&apos;, [time]) &gt;= 6 AND DATEPART(&apos;hour&apos;, [time]) &lt;= 9 THEN &quot;Peak&quot;&#10;ELSEIF DATEPART(&apos;hour&apos;, [time]) &gt;= 15 AND DATEPART(&apos;hour&apos;, [time]) &lt;= 19 THEN &quot;Peak&quot;&#10;ELSE &quot;Non-Peak&quot;&#10;END' />
      </column>
